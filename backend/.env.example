# ---- Core (required) -------------------------------------------------------

# Postgres connection string used by Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/notes?schema=public"

# Secret used to sign and verify JWTs. Use a long random value.
JWT_SECRET="replace-me-with-a-long-random-string"
JWT_EXPIRES_IN="1d"

NODE_ENV="development"
PORT=8000


# ---- Semantic search (optional) --------------------------------------------
# Without a key, notes CRUD works exactly as before; /notes/search returns 503
# and notes are simply not indexed.
#
# The index embeds text server-side (Pinecone integrated inference), so there is
# no separate embedding-provider key. Create the index once with:
#   npm run pinecone:setup

# Get one at app.pinecone.io.
PINECONE_API_KEY=""

PINECONE_INDEX="notes-chunks"

# Used by `npm run pinecone:setup` only. The embedding model and its dimension
# are fixed when the index is created; changing them needs a new index.
PINECONE_CLOUD="aws"
PINECONE_REGION="us-east-1"
PINECONE_EMBEDDING_MODEL="llama-text-embed-v2"


# ---- Ask your notes / RAG (optional) ---------------------------------------
# Powers POST /notes/ask, which retrieves the caller's own matching note chunks
# and has Claude answer from them with citations. Without a key, search still
# works and only /notes/ask returns 503.
#
# Requires PINECONE_API_KEY as well — retrieval is the first half of the answer.

# Get one at console.anthropic.com.
ANTHROPIC_API_KEY=""

# Must be a current model: the request uses adaptive thinking and `effort`.
ANTHROPIC_MODEL="claude-sonnet-5"


# ---- PDF ingestion worker --------------------------------------------------
# Uploading a PDF enqueues a job; a worker extracts the text (running OCR when
# there is no text layer) and creates the note. The upload request itself
# returns 202 immediately and the client polls /notes/pdf/jobs/:jobId.

# Run the worker inside the API process. Convenient for development — one
# command — but OCR is CPU-bound, so in production set this to "false" and run
# `npm run worker` as its own process. Several workers can run at once; they
# claim jobs with SELECT ... FOR UPDATE SKIP LOCKED and never collide.
PDF_WORKER_INLINE="true"

# How long an idle worker waits between polls, in milliseconds.
PDF_WORKER_POLL_MS=2000

# Attempts before a job is parked as FAILED. A PDF with no readable text skips
# the budget entirely — retrying cannot change the outcome.
PDF_JOB_MAX_ATTEMPTS=3

# How long a RUNNING job may go without a heartbeat before another worker
# assumes the holder died and takes it. Must stay well above the worker's
# 15s heartbeat interval.
PDF_JOB_STALE_SECONDS=120
