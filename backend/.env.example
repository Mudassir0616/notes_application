# ---- Core (required) -------------------------------------------------------

# Postgres connection string used by Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/notes?schema=public"

# Secret used to sign and verify JWTs. Use a long random value.
JWT_SECRET="replace-me-with-a-long-random-string"
JWT_EXPIRES_IN="1d"

NODE_ENV="development"
PORT=8000


# ---- Semantic search (optional) --------------------------------------------
# Without a key, notes CRUD works exactly as before; /notes/search returns 503
# and notes are simply not indexed.
#
# The index embeds text server-side (Pinecone integrated inference), so there is
# no separate embedding-provider key. Create the index once with:
#   npm run pinecone:setup

# Get one at app.pinecone.io.
PINECONE_API_KEY=""

PINECONE_INDEX="notes-chunks"

# Used by `npm run pinecone:setup` only. The embedding model and its dimension
# are fixed when the index is created; changing them needs a new index.
PINECONE_CLOUD="aws"
PINECONE_REGION="us-east-1"
PINECONE_EMBEDDING_MODEL="llama-text-embed-v2"
